    <PackageReference Include="Jellyfin.Common" Version="10.11.7" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>