<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.Comments</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Comments</RootNamespace>
    <Nullable>enable</Nullable>
    <Version>0.1.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/comments.js" LogicalName="Jellyfin.Plugin.Comments.Web.comments.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.7" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.7" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Common" Version="10.11.7" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>